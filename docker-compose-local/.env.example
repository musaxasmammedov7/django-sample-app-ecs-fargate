# Copy this file to `.env` and adjust the values for your machine.
# NEVER commit the real `.env` file — it is git-ignored.
# These are generic development placeholders; production secrets come from AWS
# Secrets Manager (managed by ECS), not from this file.

DB_NAME=django_db
DB_USER=django_user
DB_PASSWORD=django_pass_dev
DB_SSLMODE=disable

SECRET_KEY=local_dev_secret_key_change_me

SITE_ROOT=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

DEBUG=False